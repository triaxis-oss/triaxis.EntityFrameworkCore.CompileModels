<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PackageUnderTest>triaxis.EntityFrameworkCore.CompileModels</PackageUnderTest>
    <!-- The EF Core the generated fixture projects reference. -->
    <EFCoreTestVersion>10.0.11</EFCoreTestVersion>
    <PackageUnderTestFeed>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'feed'))</PackageUnderTestFeed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- For the build order alone: packing a project the solution is building at the same time has
       the two of them writing to one output directory. -->
  <ItemGroup>
    <ProjectReference Include="../$(PackageUnderTest)/$(PackageUnderTest).csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The tests build throwaway projects against the real package, so the package has to exist before
    they run, and the projects they generate have to know where to find it. Its version is derived
    from the MSBuild logic it ships: unchanged logic keeps the version, so NuGet's cached extraction
    stays valid, and changed logic gets a version NuGet has never seen and therefore cannot serve
    from an earlier run.
  -->
  <Target Name="PackPackageUnderTest" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_PackageUnderTestInput Include="../$(PackageUnderTest)/build/**" />
    </ItemGroup>
    <ReadLinesFromFile File="%(_PackageUnderTestInput.FullPath)">
      <Output TaskParameter="Lines" ItemName="_PackageUnderTestLine" />
    </ReadLinesFromFile>
    <Hash ItemsToHash="@(_PackageUnderTestInput);@(_PackageUnderTestLine)">
      <Output TaskParameter="HashResult" PropertyName="_PackageUnderTestHash" />
    </Hash>
    <PropertyGroup>
      <_PackageUnderTestVersion>0.0.0-test.$(_PackageUnderTestHash)</_PackageUnderTestVersion>
    </PropertyGroup>
    <MSBuild Projects="../$(PackageUnderTest)/$(PackageUnderTest).csproj" Targets="Pack"
             Properties="Configuration=$(Configuration);PackageVersion=$(_PackageUnderTestVersion);PackageOutputPath=$(PackageUnderTestFeed);NoBuild=true" />
    <ItemGroup>
      <AssemblyMetadata Include="PackageUnderTest" Value="$(PackageUnderTest)" />
      <AssemblyMetadata Include="PackageUnderTestFeed" Value="$(PackageUnderTestFeed)" />
      <AssemblyMetadata Include="PackageUnderTestVersion" Value="$(_PackageUnderTestVersion)" />
      <AssemblyMetadata Include="EFCoreVersion" Value="$(EFCoreTestVersion)" />
    </ItemGroup>
  </Target>

</Project>
