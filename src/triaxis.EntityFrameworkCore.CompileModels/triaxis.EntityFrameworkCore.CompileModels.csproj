<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The oldest runtime the generator has to start on. It binds to whatever
         Microsoft.EntityFrameworkCore.Design the project being built resolved, so the reference
         below is compile-time only and its version is a floor, not a match. -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The package ships MSBuild logic under build/ and the generator under tools/. It has no
         library for a project to reference and brings no dependencies along. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <Target Name="_PackGenerator">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="tools/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

</Project>
